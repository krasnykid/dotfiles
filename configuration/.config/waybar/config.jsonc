{
  "layer": "top",
  "position": "top",
  "spacing": 0,

  // Left side
  "modules-left": [
    "hyprland/workspaces",
    "custom/layout",
  ],

  "modules-center": ["hyprland/window"],

  // Right side
  "modules-right": [
    "pulseaudio/slider",
    "bluetooth",
    "network",
    "custom/sysmon",
    "battery",
    "clock",
    "custom/power"
  ],

  "custom/layout": {
      "exec": "~/.config/waybar/scripts/layout.sh",
      "return-type": "json",
      "signal": 8,
      "format": "{icon}",
      "format-icons": {
          "dwindle": "󰕰",
          "scrolling": "",
          "default": "?"
      }
  },

  // Load module definitions
  "include": ["~/.config/waybar/modules.json"],
}
