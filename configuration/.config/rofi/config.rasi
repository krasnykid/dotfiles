configuration {
    modes: "drun,run";
    font: "Inter Medium 11";
    terminal: "kitty";
    show-icons: false;
    drun-display-format: "{name}";
    display-drun: "APPS";
    display-run: "RUN";
    matching: "fuzzy";
    sorting-method: "fzf";
    sort: true;
    case-sensitive: false;
    disable-history: false;
    max-history-size: 25;
    click-to-exit: true;
    sidebar-mode: false;
}

@theme "yasno"
