// Waybar's off-white foreground and quiet monochrome active states.
* {
    // Let Hyprland's background blur show through; keep text fully opaque.
    background: #10111480;
    foreground: #e6e8ee;
    muted: #858994;
    line: #ffffff18;
    selection: #e6e8ee;
    selected-text: #101114;

    background-color: transparent;
    text-color: @foreground;
    border-color: @line;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    location: center;
    anchor: center;
    width: 520px;
    border: 1px;
    border-radius: 14px;
    background-color: @background;
}

mainbox {
    children: [ inputbar, listview, message ];
    padding: 18px;
    spacing: 12px;
}

inputbar {
    children: [ prompt, entry ];
    spacing: 14px;
    padding: 4px 4px 16px;
    border: 0 0 1px;
}

prompt {
    font: "Inter SemiBold 9";
    text-color: @muted;
    vertical-align: 0.5;
}

entry {
    placeholder: "Search…";
    placeholder-color: @muted;
    cursor: text;
    vertical-align: 0.5;
}

listview {
    columns: 1;
    lines: 7;
    fixed-height: true;
    dynamic: true;
    scrollbar: false;
    spacing: 4px;
}

element {
    children: [ element-text ];
    padding: 10px 12px;
    border-radius: 7px;
    cursor: pointer;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @foreground;
}

element normal.active,
element alternate.active {
    background-color: #ffffff0c;
    text-color: #ffffff;
}

element normal.urgent,
element alternate.urgent {
    text-color: #f0b5b5;
}

element selected.normal,
element selected.active,
element selected.urgent {
    background-color: @selection;
    text-color: @selected-text;
}

element-text {
    background-color: inherit;
    text-color: inherit;
    vertical-align: 0.5;
    highlight: bold;
    cursor: inherit;
}

message {
    border: 1px 0 0;
    padding: 12px 4px 0;
}

textbox {
    text-color: @muted;
}

error-message {
    padding: 18px;
    background-color: @background;
}
