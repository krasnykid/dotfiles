inoremap jk <Esc>
inoremap kj <Esc>

" Delete the previous word in insert mode using Option + Delete (Alt + Backspace)
inoremap <A-BS> <C-w>

nnoremap ; :
vnoremap ; :

" Navigate character-by-character in Insert Mode using Ctrl + hjkl
inoremap <C-h> <Left>
inoremap <C-j> <Down>
inoremap <C-k> <Up>
inoremap <C-l> <Right> 

set scrolloff=20
